[
  {
    "label": "Build & Debug",
    "build": {
      "command": "cargo",
      "args": ["build"],
    },
    "env": {
      "HOST": "0.0.0.0:3000",
      "DATABASE_URL": "sqlite://app.db",
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/poemguessr",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
]
